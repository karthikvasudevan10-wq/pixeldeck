<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud: sprite sync (iCloud Documents) and Community (CloudKit public database). -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.karthikvasudevan.pixeldeck</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.karthikvasudevan.pixeldeck</string>
	</array>
	<!-- Shares the age check's result with the widget. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.karthikvasudevan.pixeldeck</string>
	</array>
	<!-- Community is off for under-13s: ask iOS for the age range (iOS 26+). -->
	<key>com.apple.developer.declared-age-range</key>
	<true/>
	<!-- Mac (Catalyst): the App Sandbox, required for the Mac App Store. Ignored on iPhone and iPad. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Mac: the local server AI assistants connect to (Settings › AI assistants). It listens on this Mac only. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
</dict>
</plist>
