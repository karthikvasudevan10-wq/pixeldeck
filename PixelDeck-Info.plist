<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates from the build settings (INFOPLIST_KEY_...). -->
	<!-- The name in the Mac's menu bar. -->
	<key>CFBundleName</key>
	<string>Pixel Deck</string>
	<!-- Files Pixel Deck opens: Playground levels people send each other, and Aseprite sprites. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Pixel Deck level</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>karthikvasudevan.pixeldeck.level</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Aseprite sprite</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.aseprite.sprite</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>karthikvasudevan.pixeldeck.level</string>
			<key>UTTypeDescription</key>
			<string>Pixel Deck level</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pixeldecklevel</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.aseprite.sprite</string>
			<key>UTTypeDescription</key>
			<string>Aseprite sprite</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>aseprite</string>
					<string>ase</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- Files are read where they are (the Mac requires this); Pixel Deck then keeps its own copy. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
